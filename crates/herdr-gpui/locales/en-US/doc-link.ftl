# Document header control. Connecting keeps the document subscribed even when
# its editor tab closes.
doc-link-connect = Connect agent
doc-link-connected = Agent connected
doc-link-paused = Agent paused
doc-link-restoring = Reconnecting agent
doc-link-connecting = Connecting agent
doc-link-off-help = Connect an agent to this document and send its settled changes automatically.
# $agent is the private name of the linked agent.
doc-link-on-help = Connected to { $agent }. Turning this off leaves the agent running.
doc-link-waiting = The agent is not ready for prompts. Changes will retry automatically.
doc-link-starting-help = Starting the document's agent. Turning this off leaves any started agent running.
