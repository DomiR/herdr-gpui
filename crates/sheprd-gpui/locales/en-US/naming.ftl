# The row under a workspace's or tab's rename field that asks an agent for a name.

# Claude runs once on its own over the chats and terminals there.
naming-with-claude = Name with Claude
# $agent is the agent working there, such as Claude or Codex; it is asked in its own conversation.
naming-ask-agent = Ask { $agent }
# Shown on the button while the name is on its way.
naming-running = Naming…
