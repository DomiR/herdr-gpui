# Why an agent gave a rename dialog no name.

# $agent is the agent that was asked, such as Claude or Codex.
error-naming-blocked = { $agent } is waiting for an answer; reply to it first
# $error is herdr-core's own message.
error-naming-core = Cannot reach herdr-core: { $error }
error-naming-empty = Nothing has been said or shown here yet
error-naming-gone = The agent left before it answered
# $agent is the agent that was asked.
error-naming-no-name = { $agent } did not suggest a name
# $error is the host's own message.
error-naming-script = Herdr could not reach the pane: { $error }
# $agent is the agent that was asked.
error-naming-timed-out = { $agent } did not answer in time
