# What Add Device shows once an SSH device is saved.

devices-setup-existing-server = Device added with the existing Herdr server. Version or startup differences may affect recovery after SSH disconnects.
devices-setup-done = Done
devices-setup-progress = Setting up { $target }…
devices-setup-response = Password or response
devices-setup-response-hint = Enter a response when setup asks. Passwords stay hidden and are not saved.
devices-setup-yes = Yes
devices-setup-no = No
devices-setup-send = Send response
