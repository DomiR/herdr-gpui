# Recording a page review with Scrawl (macOS). Scrawl is a product name.
# $error is Scrawl's, the system's, or ScreenCaptureKit's text; $path a folder.

error-record-import = Scrawl did not build the review: { $error }
error-record-import-timeout = Scrawl took longer than { $minutes } minutes to build the review
error-record-missing-summary = Scrawl wrote no summary in { $path }
error-record-no-window = This window is not one macOS will record; is it on screen?
error-record-page-hidden = The page is not on screen
error-record-failed = The recording did not finish: { $error }
error-record-timeout = The recording did not finish in time
error-record-unavailable = Recording needs macOS 15 or later
error-record-scrawl-missing = Install Scrawl to record page reviews: scrawl.kitlangton.com
error-record-screen-recording = Allow Herdr to record the screen in System Settings, Privacy & Security, Screen & System Audio Recording, then open Herdr again
error-record-stream = macOS refused to record: { $error }
error-record-video-path = The recording's file cannot be written there
