# Why `sheprd chat new --prompt` or `--prompt-file` could not read the brief
# it starts a chat with.

error-chat-brief-empty = The brief is empty.
error-chat-brief-open = Could not open { $path }.
error-chat-brief-read = Could not read the brief.
error-chat-brief-text = The brief is not UTF-8 text.
error-chat-brief-too-long = The brief is longer than { $bytes } bytes.
