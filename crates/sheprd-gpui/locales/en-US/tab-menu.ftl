# A Herdr tab's menu, from a right-click on the tab, and its rename and move
# pages.

tab-menu-new-tab = New Tab
tab-menu-rename = Rename
# Opens the list of workspaces the tab can move to.
tab-menu-move-to-workspace = Move to Workspace…
# Stops the tab's terminal agent and continues its conversation in a chat, in
# the same pane. Same words as the palette's commands-convert-to-chat.
tab-menu-move-to-chat = Move Agent into Chat
# Silences the tab's notifications, or lets them through again.
tab-menu-mute = Mute Notifications
tab-menu-unmute = Unmute Notifications
# The tab's whole workspace is muted; the row unmutes the workspace.
tab-menu-unmute-workspace = Unmute Workspace
tab-menu-copy-link = Copy Link
# The tab's whole device is muted; the row unmutes the device.
tab-menu-unmute-device = Unmute Device
tab-menu-close = Close Tab
tab-menu-link-copied = Link copied
tab-menu-copy-link-failed = Could not make a link for this tab

tab-menu-rename-placeholder = Tab name
tab-menu-rename-title = Rename tab
tab-menu-cancel = Cancel
tab-menu-renaming = Renaming...
tab-menu-rename-submit = Rename

tab-menu-moving = Moving tab…
tab-menu-move-heading = Move to workspace
