# Settings > Notifications, beyond the rows search finds (settings.ftl).

## Groups on the page.

settings-notifications-section-delivery = 配信
settings-notifications-section-toasts = アプリ内トースト
settings-notifications-section-sound = サウンド

## Rows.

# Where agent notifications go: nowhere, Sheprd's in-app toasts, the
# terminal, or the system's notifications.
settings-notifications-delivery-off = オフ
settings-notifications-delivery-herdr = Sheprd
settings-notifications-delivery-terminal = ターミナル
settings-notifications-delivery-system = システム
settings-notifications-finished-description = オフにすると、エージェントの各ターン終了時の通知を、アプリ内でもシステムでも出しません。対応が必要なときの通知は引き続き表示されます。
settings-notifications-position-description = コントロールには実際に適用される値が表示されます。管理ファイルによる上書きは引き続き優先されます。
settings-notifications-delay-description = トーストを表示するまで待機し、すぐ終わるターンでは通知しないようにします。コントロールには実際に適用される値が表示されます。管理ファイルによる上書きは引き続き優先されます。
settings-notifications-delay-reset = リセット
settings-notifications-sound-description = Herdr のサウンドのパスとエージェントごとの上書き設定を使用します。カスタムサウンドが見つからない場合は、同梱のサウンドを使用します。
settings-notifications-sound-description-no-window = Herdr のサウンドのパスとエージェントごとの上書き設定を使用します。カスタムサウンドが見つからない場合は、同梱のサウンドを使用します。音声をプレビューするには、Sheprd のメインウインドウを開いてください。
settings-notifications-sound-test = テスト
settings-notifications-quiet-off = オフ
