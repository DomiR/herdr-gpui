settings-error-reload = 无法重新加载设置，已保留当前设置：{ $error }
settings-error-load-herdr = 加载 Herdr 设置失败：{ $error }

settings-shared-read-only = 在此平台上，Herdr 设置为只读。
settings-shared-unavailable = Herdr 设置不可用。请重新加载后再试。
